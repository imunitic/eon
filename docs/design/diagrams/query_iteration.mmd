---
title: Eon ECS — Query Iteration (Smallest-Set-First)
---
%% iter2 / iter3 / iter4: base = smallest sparse set; check membership in the rest
flowchart TB
    classDef pos fill:#d0ebff,stroke:#1971c2,color:#1e1e1e
    classDef base fill:#ffd8a8,stroke:#e8590c,color:#1e1e1e
    classDef health fill:#d3f9d8,stroke:#2f9e44,color:#1e1e1e
    classDef included fill:#b2f2bb,stroke:#2f9e44,color:#1e1e1e
    classDef excluded fill:#ffc9c9,stroke:#c2255c,color:#1e1e1e
    classDef note fill:#fff9db,stroke:#f08c00,color:#1e1e1e

    POS["Position (6 entities)<br/>1 2 3 4 5 6"]
    VEL["Velocity (2)<br/>2 5<br/>smallest — base"]
    HEALTH["Health (4 entities)<br/>1 2 4 6"]

    subgraph CHECK["Membership check for base entities (iterate Velocity, test Position & Health)"]
        direction TB
        E2["Entity 2 (from base: Velocity)<br/>Position: present<br/>Health: present<br/>Included — f called for this entity"]
        E5["Entity 5 (from base: Velocity)<br/>Position: present<br/>Health: ABSENT<br/>Excluded — View skips it"]
    end

    VEL --> CHECK
    POS -.-> CHECK
    HEALTH -.-> CHECK

    LEGEND["Legend<br/>present in that sparse set / absent<br/>membership check passes / fails"]

    class POS pos
    class VEL base
    class HEALTH health
    class E2 included
    class E5 excluded
    class LEGEND note
