{0 eon-ecs — Entity Component System}

Eon ECS is a minimal, data-oriented ECS library for OCaml 5. It provides
entities, typed component storage, message buses, a system scheduler, and a
fixed/variable-step game loop — all wired together through a default stack
you can use directly or customise via functors.

This page is the front of a short book: read the {b Guides} below in order
for a start-to-finish walkthrough of every public feature, with real,
compiled code examples throughout (the source for every example lives in
{{:https://github.com/imunitic/eon/tree/main/eon_ecs/examples/book}[eon_ecs/examples/book/]},
compiled as part of the normal build — {i not} illustrative pseudocode). If
you already know what you're looking for, jump straight to the {b API
reference} at the bottom instead.

{1 Quick start}

{[
  (* 1. Alias the default stack *)
  module World    = Eon_ecs.World
  module System   = Eon_ecs.System.Default
  module Pipeline = Eon_ecs.Pipeline.Default
  module Progress = Eon_ecs.Progress.Default
  module Loop     = Eon_ecs.Loop.Default
  module Signals  = Eon_ecs.Signals
  module Events   = Eon_ecs.Events
  module Commands = Eon_ecs.Commands

  (* 2. Create world and register components *)
  let world = World.create ()
  let _pos  = World.register_component world ~name:"Position" ~id:0
  let _vel  = World.register_component world ~name:"Velocity" ~id:1

  (* 3. Spawn an entity *)
  let player = World.create_entity world
  let () =
    World.add_component world player ~name:"Position" (0.0, 0.0);
    World.add_component world player ~name:"Velocity" (1.0, 0.5)

  (* 4. Define a system *)
  let movement =
    System.make
      ~update:(fun world dt ->
        Eon_ecs.Query.iter2 world "Position" "Velocity"
          (fun _entity (px, py) (vx, vy) ->
            ignore (px +. vx *. dt, py +. vy *. dt)))
      ~kind:`Variable
      ()

  (* 5. Build a pipeline *)
  let pipeline =
    Pipeline.create ()
    |> Pipeline.add_phase `Gameplay
    |> Pipeline.add_system `Gameplay movement

  (* 6. Create a progress controller and run *)
  let progress = Progress.create ~mode:(Progress.Variable) pipeline
  let _world =
    Loop.run
      ~progress
      ~world
      ~should_continue:(fun _world -> false)
      ()
]}

The quick start above uses bare tuples for speed of reading; the book
guides below use real named component modules throughout — see
{{!page-world_and_components}World and components} for why that distinction
matters once code grows past a single file.

{1 Guides}

- {{!page-world_and_components}World and components} — {!Eon_ecs.World},
  {!Eon_ecs.Entity_id}, {!Eon_ecs.Component}: registration, the add/set/
  get/remove lifecycle, the raises-vs-[None] contract, [component_generation],
  and the data/service stores.
- {{!page-queries}Queries} — {!Eon_ecs.Query}: [iter1] through [iter4],
  [count]/[iter_entities], and why smallest-set-first keeps rare-component
  queries cheap regardless of world size.
- {{!page-buses}Buses} — {!Eon_ecs.Signals}/{!Eon_ecs.Events}/
  {!Eon_ecs.Commands}: same-frame vs. next-frame delivery, and subscriber
  ordering.
- {{!page-systems}Systems} — {!Eon_ecs.System}: building systems from
  optional callbacks, and wiring a system's handlers to buses by hand.
- {{!page-pipelines}Pipelines} — {!Eon_ecs.Pipeline}: phases, ordering,
  [register_all]/[reset], and the scene-transition pattern.
- {{!page-progress_and_loop}Progress and Loop} — {!Eon_ecs.Progress}
  ([Variable]/[Fixed]/[Hybrid] modes), {!Eon_ecs.Loop} (frame order,
  [step]/[run]), and {!Eon_ecs.Clock}.

