{0 eon-engine — Game Engine Layer}

Eon Engine builds on top of [eon-ecs] and adds:

- {b Typed component descriptors} — no more string-keyed lookups in game code
- {b Capability-typed world} — phantom types ([ro]/[rw]) prevent writes from parallel systems at compile time
- {b Query builder} — composable filters with a typed [View] cursor
- {b Parallel pipeline} — [Parallel] systems run concurrently via [Executor]; [Exclusive] systems run sequentially after
- {b Built-in components} — [Local_transform]/[World_transform] (position, rotation, scale — see below), [Parent]/[Children], [Velocity], [Sprite], [Animation], [Camera], [Collider], [Tag]

{1 Quick start}

{[
  open Eon_engine

  (* 1. Alias the default stack *)
  module Pipeline = Pipeline.Default
  module Progress = Progress
  module Loop     = Loop

  (* 2. Create world and register built-in components *)
  let world = World.create ()
  let ()    = Components.Engine_components.register_all world

  (* 3. Define a component for game-specific data *)
  let health : int Components.t = component "Health"
  let () = ignore (World.register world health)

  (* 4. Spawn an entity *)
  let player = World.create_entity world
  let () =
    World.add_component world player Components.Local_transform.component
      ({ position = Math.Vec2.zero; rotation = 0.0; scale = Math.Vec2.one }
       : Components.Local_transform.t);
    World.add_component world player Components.Velocity.component
      ({ dx = 1.0; dy = 0.5 } : Components.Velocity.t);
    World.add_component world player health 100

  (* 5. Define a parallel system: [update] only reads (via [Query]) and
     emits a command — a [Parallel] system's world is [ro], so it cannot
     write directly. The write happens in [on_command], which runs
     sequentially during [drain]. [System.make_parallel] takes a
     first-class module — its types are fixed by the module's own type
     declarations, so (unlike the raw [System.Default.make] constructor)
     no type annotation is needed here. *)
  module Movement = struct
    type signal  = unit
    type event   = unit
    type command = [ `Move of entity_id * float * float ]

    let on_signal  _ _ = ()
    let on_event   _ _ = ()

    let on_command (world : World.rw World.t) = function
      | `Move (e, x, y) ->
        World.set_component world e Components.Local_transform.component
          ({ position = Math.Vec2.create x y; rotation = 0.0; scale = Math.Vec2.one }
           : Components.Local_transform.t)

    let update (world : World.ro World.t) dt =
      let bus = Buses.Default.commands () in
      Query.Default.from world
      |> Query.Default.having Components.Local_transform.name
      |> Query.Default.having Components.Velocity.name
      |> Query.Default.iter (fun view ->
           let e   = View.entity view in
           let lt  = View.get view (module Components.Local_transform) in
           let vel = View.get view (module Components.Velocity) in
           Commands.emit bus
             (`Move (e, lt.position.x +. vel.dx *. dt,
                        lt.position.y +. vel.dy *. dt)))
  end

  let movement_system = System.make_parallel (module Movement)

  (* 6. Build a pipeline *)
  let pipeline : [ `Gameplay ] Pipeline.t =
    Pipeline.create ()
    |> Pipeline.add_phase `Gameplay
    |> Pipeline.add_system `Gameplay movement_system

  (* 7. Build loop and run — note: [Pipeline] already aliases
     [Eon_engine.Pipeline.Default] via the [module Pipeline = Pipeline.Default]
     alias above, so it's passed directly here, not as [Pipeline.Default]. *)
  module Engine_progress = Progress.Make(Pipeline)
  module Engine_loop =
    Loop.Make(Eon_ecs.Clock.Mtime)(Engine_progress)(Platform.Headless)(Loop_buses)

  let progress = Engine_progress.create ~mode:Engine_progress.Variable pipeline
  let _world =
    Engine_loop.run ~progress ~world ~should_continue:(fun _w -> false) ()
]}

{1 Guides}

- {{!page-world_and_components}World and components} — World capabilities
  ([ro]/[rw]), component descriptors, the built-in components table,
  {!Eon_engine.Resource}/{!Eon_engine.Service}, and {!Eon_engine.Namespace}
  for cross-world access.
- {{!page-queries_and_systems}Queries and systems} — {!Eon_engine.Query},
  {!Eon_engine.Cached_backend} for opt-in per-signature query-result
  caching, [Parallel]/[Exclusive] systems (module-based and inline-closure
  styles), reactive bus handlers, and {!Eon_engine.Executor}.
- {{!page-platform_and_loop}Platform and loop} — buses in their platform
  context, {!Eon_engine.Input_backend}, {!Eon_engine.Platform.S}, and
  {!Eon_engine.Loop.Make}'s per-frame orchestration.
- {{!page-math}Math types} — [Vec2], [Vec2i], [Rect], [Circle],
  [Transform2D]: construction, common patterns, tile coordinate conversion,
  spatial queries, hierarchy transforms, and shape-vs-shape collision
  detection.
- {{!page-transform_and_lifecycle}Transform hierarchy and entity lifecycle}
  — [Local_transform], [World_transform], [Parent], [Children],
  [Transform_system], [Lifecycle_system]: DFS world-transform propagation,
  reparenting, entity destruction, registration order, and cascade
  patterns.
- {{!page-rendering}Rendering} — [Color], [Render_commands],
  [Render_stream], [Render_stream_collector], [Rendering_backend]: command
  vocabulary, phase-ordered collection, multi-camera setup, and backend
  wiring.
- {{!page-audio}Audio} — [Audio_backend], [Audio_command],
  [Audio_command_buffer]: the command vocabulary, the shared per-frame
  buffer any system can append to, voice budget prioritization, and a
  worked spatial-audio example.
- {{!page-prefab}Prefab loading} — [Prefab.Make], [Prefab_edn],
  [Prefab_edn_defaults], [Asset_lookup]: using the built-in EDN loader,
  writing a custom [Component_deserializer], [:extends]/[:children]
  conventions, building a non-EDN instantiation from scratch, and mapping
  logical asset ids to files.

